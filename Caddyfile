(site_headers) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
}

(site_public) {
	@research path /research /research/
	handle @research {
		root * /var/www/personal-site
		rewrite * /research/index.html
		file_server
	}

	@projects path /projects /projects/
	handle @projects {
		root * /var/www/personal-site
		rewrite * /projects/index.html
		file_server
	}

	@notes path /notes /notes/
	handle @notes {
		root * /var/www/personal-site
		rewrite * /notes/index.html
		file_server
	}

	@contact path /contact /contact/
	handle @contact {
		root * /var/www/personal-site
		rewrite * /contact/index.html
		file_server
	}

	@anime path /anime /anime/
	handle @anime {
		root * /var/www/personal-site
		rewrite * /anime/index.html
		file_server
	}

	@studio_logout path /studio-logout /studio-logout/
	handle @studio_logout {
		root * /var/www/personal-site
		rewrite * /studio-logout/index.html
		file_server
	}

	@life_index path /life /life/
	handle @life_index {
		basicauth {
