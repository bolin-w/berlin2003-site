		root * /var/www/personal-site
		rewrite * /life/index.html
		file_server
	}

	handle /life* {
		basicauth {
			berlin2003 $2a$14$97EEL.qDfGDDt9q5VCKwnO.M07a5FLldWyJ5sFSVk1./xV1VGRtkq
		}
		root * /var/www/personal-site
		file_server
	}

	@studio_index path /studio /studio/
	handle @studio_index {
		basicauth {
			berlin2003 $2a$14$97EEL.qDfGDDt9q5VCKwnO.M07a5FLldWyJ5sFSVk1./xV1VGRtkq
		}
		root * /var/www/personal-site
		rewrite * /studio/index.html
		file_server
	}

	handle /studio* {
		basicauth {
			berlin2003 $2a$14$97EEL.qDfGDDt9q5VCKwnO.M07a5FLldWyJ5sFSVk1./xV1VGRtkq
		}
		root * /var/www/personal-site
		file_server
	}

	handle /api/ai/* {
		basicauth {
			berlin2003 $2a$14$97EEL.qDfGDDt9q5VCKwnO.M07a5FLldWyJ5sFSVk1./xV1VGRtkq
		}
		reverse_proxy 127.0.0.1:8787
	}

	handle /api/public/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle /api/editor/* {
		basicauth {
			berlin2003 $2a$14$97EEL.qDfGDDt9q5VCKwnO.M07a5FLldWyJ5sFSVk1./xV1VGRtkq
		}
		reverse_proxy 127.0.0.1:8787
