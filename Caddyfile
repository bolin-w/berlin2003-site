	handle /api/admin/anime/* {
		basicauth {
			berlin2003 $2a$14$97EEL.qDfGDDt9q5VCKwnO.M07a5FLldWyJ5sFSVk1./xV1VGRtkq
		}
		reverse_proxy 127.0.0.1:8788
	}

	handle /api/anime/* {
		reverse_proxy 127.0.0.1:8788
	}

	handle /media/anime/* {
		root * /var/lib/berlin2003-anime/videos
		uri strip_prefix /media/anime
		file_server
	}

	handle {
		root * /var/www/personal-site
		file_server
	}
